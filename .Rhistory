metab <- rv$metab
trt <- rv$trt
c_temp <- rv$temp
# 1. Subset
df_sub <- metabol_dfs[[metab]] %>%
filter(treatment %in% c(control, trt), temp == c_temp) %>%
mutate(trt_bin = factor(treatment, levels = c(control, trt)),
time_point = as.factor(time_point))
# 2. Extract stats
stats_row <- lrt_results %>% filter(metabolite == metab, temperature == c_temp, treatment == trt)
lrt_val <- round(stats_row$ss, 3)
p_val <- format.pval(stats_row$adj_p, digits = 3, eps = 0.001)
stats_text <- paste0("LRT Stat: ", lrt_val, "\nAdj. p: ", p_val)
# 3. Model Fits
null_fit <- lm(as.formula(paste0(metab, " ~ time_point")), data = df_sub)
full_fit <- lm(as.formula(paste0(metab, " ~ trt_bin * time_point")), data = df_sub)
u_times <- levels(df_sub$time_point)
pred_null <- data.frame(time_point = factor(u_times, levels = u_times))
pred_null$val <- predict(null_fit, newdata = pred_null)
pred_full <- expand.grid(time_point = factor(u_times, levels = u_times),
trt_bin = factor(c(control, trt), levels = c(control, trt)))
pred_full$val <- predict(full_fit, newdata = pred_full)
# 4. Final Plot
ggplot(df_sub, aes_string(x = "time_point", y = metab)) +
geom_jitter(aes(color = trt_bin), width = 0.1, alpha = 0.4, size = 3) +
geom_line(data = pred_full, aes(x = time_point, y = val, color = trt_bin, group = trt_bin),
linewidth = 1) +
geom_line(data = pred_null, aes(x = time_point, y = val, group = 1),
color = "black", linetype = "dashed", linewidth = 0.8) +
annotate("label", x = Inf, y = Inf, label = stats_text,
hjust = 1.1, vjust = 1.1, size = 4, fill = "white", alpha = 0.8) +
labs(title = paste("Metabolite:", metab, "| Temp:", c_temp),
subtitle = paste("Comparison:", control, "vs", trt),
caption = "Dashed = Null (Time only) | Colored = Full (Trt * Time)",
x = "Time Point (Factor)", y = "Abundance", color = "Group") +
theme_bw(base_size = 14)
})
}
shinyApp(ui, server)
